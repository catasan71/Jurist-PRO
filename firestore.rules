rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function emailIsAdmin() {
      return isAuthenticated() && 
             (
               (request.auth.token.email != null && request.auth.token.email.lower() in ["catalinsandu07@gmail.com", "admin@juristpro.ai", "juristpro.ai@gmail.com"]) ||
               (request.auth.uid == "mP5qKCHEHZbnrPp3JzNaE7pEwci2")
             );
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          emailIsAdmin() ||
          (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == "admin")
        );
    } 

    function isSystemAdmin() {
       return emailIsAdmin();
    }

    function isValidContactMessage(data) {
      return data.name is string && data.name.size() > 0 &&
             data.email is string && 
             data.message is string && data.message.size() > 0;
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isValidEmail(email) {
      return email is string && email.size() >= 5 && email.contains("@");
    }

    function isValidProfile(data) {
      return data.id is string &&
             data.full_name is string &&
             data.role in ['admin', 'lawyer'] &&
             data.plan in ['trial', 'expert', 'gold'] &&
             data.status in ['active', 'pending_payment', 'expired', 'trial', 'cancelled'] &&
             data.credits is number;
    }

    function isValidEvent(data) {
      return data.user_id is string && data.user_id == request.auth.uid &&
             data.title is string && data.title.size() > 0 &&
             data.event_date is string &&
             data.type is string;
    }

    function isValidTicket(data) {
      return data.user_id is string && data.user_id == request.auth.uid &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && isValidEmail(data.email) &&
             data.type is string && data.type.size() <= 50 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 2000 &&
             data.status in ['open', 'in_progress', 'resolved', 'closed'];
    }

    function isValidTransaction(data) {
      return data.user_id is string && data.user_id == request.auth.uid &&
             data.amount is number &&
             data.type is string &&
             data.status is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Rules for Legal Sources (Publicly readable, Admin writable)
    match /legal_sources/{sourceId} {
      allow read: if isAuthenticated();
      allow write: if emailIsAdmin();
    }

    // Rules for Legal Articles
    match /legal_articles/{articleId} {
      allow read: if isAuthenticated();
      allow write: if emailIsAdmin();
    }

    // Rules for Legal Embeddings
    match /legal_embeddings/{embeddingId} {
      allow read: if isAuthenticated();
      allow write: if emailIsAdmin();
    }

    // Rules for System Settings
    match /system_settings/{settingId} {
      allow read: if true; 
      allow write: if emailIsAdmin();
    }

    // Rules for Contact Messages
    match /contact_messages/{messageId} {
      allow create: if isValidContactMessage(request.resource.data);
      allow read, update, delete: if emailIsAdmin();
    }

    // Rules for Profiles
    match /profiles/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Rules for Events
    match /events/{eventId} {
      allow read, write: if isOwner(resource.data.user_id) || (isAuthenticated() && request.resource.data.user_id == request.auth.uid) || emailIsAdmin();
    }

    // Rules for Tickets
    match /tickets/{ticketId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isOwner(resource.data.user_id) || emailIsAdmin();
    }

    // Rules for Transactions
    match /transactions/{transactionId} {
      allow read: if isOwner(resource.data.user_id) || emailIsAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if emailIsAdmin();
    }

    // Rules for Promo Codes
    match /promo_codes/{codeId} {
      allow read, write: if emailIsAdmin() || isAdmin();
      allow get: if isAuthenticated();
      allow update: if isAuthenticated() && 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy']) &&
                       request.auth.uid in request.resource.data.usedBy;
    }
  }
}
